{
  "name": "owla11y-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/react"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-react-css.mjs && tsc -p packages/react/tsconfig.json && node scripts/assemble-react.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p packages/react/tsconfig.test.json",
    "verify:package": "node scripts/verify-react-package.mjs",
    "dev": "vite --host 127.0.0.1 examples/client-consumer",
    "build:example": "vite build examples/client-consumer",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4",
    "jsdom": "^26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^4"
  }
}
