{
  "component": {
    "dialog": {
      "backdrop": {
        "background": {
          "$value": "{color.overlay.modal}",
          "$type": "color",
          "$description": "Dialog alias of the shared modal overlay colour. It separates the active dialog from inert page content without being the only indication that the dialog is open.",
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-backdrop-background)"
            }
          }
        }
      },
      "surface": {
        "background": {
          "$value": "{color.surface.raised}",
          "$type": "color",
          "$description": "Dialog surface colour.",
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-surface-background)"
            }
          }
        },
        "border": {
          "$value": "{color.border.light}",
          "$type": "color",
          "$description": "Dialog boundary colour.",
          "$extensions": {
            "com.figma.scopes": [
              "STROKE_COLOR"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-surface-border)"
            }
          }
        },
        "radius": {
          "$value": "{radius.xl}",
          "$type": "borderRadius",
          "$description": "Dialog corner radius for inset layouts. Full-screen dialogs use radius.none.",
          "$extensions": {
            "com.figma.scopes": [
              "CORNER_RADIUS"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-surface-radius)"
            }
          }
        }
      },
      "size": {
        "small": {
          "$value": "32rem",
          "$type": "dimension",
          "$description": "Maximum inline size for short confirmations and focused tasks. At a 16px root size, 32rem equals 512px.",
          "$extensions": {
            "com.figma.scopes": [
              "WIDTH_HEIGHT"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-size-small)"
            }
          }
        },
        "medium": {
          "$value": "40rem",
          "$type": "dimension",
          "$description": "Default maximum inline size for forms and standard dialog content. At a 16px root size, 40rem equals 640px.",
          "$extensions": {
            "com.figma.scopes": [
              "WIDTH_HEIGHT"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-size-medium)"
            }
          }
        },
        "large": {
          "$value": "56rem",
          "$type": "dimension",
          "$description": "Maximum inline size for complex content that genuinely benefits from more room. At a 16px root size, 56rem equals 896px.",
          "$extensions": {
            "com.figma.scopes": [
              "WIDTH_HEIGHT"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-size-large)"
            }
          }
        },
        "viewportInset": {
          "$value": "{spacing.4}",
          "$type": "spacing",
          "$description": "Minimum space between an inset dialog and each viewport edge, including on mobile.",
          "$extensions": {
            "com.figma.scopes": [
              "WIDTH_HEIGHT"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-size-viewportInset)"
            }
          }
        }
      },
      "spacing": {
        "header": {
          "$value": "{spacing.inset.lg}",
          "$type": "spacing",
          "$description": "Default inset for the dialog header.",
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-spacing-header)"
            }
          }
        },
        "content": {
          "$value": "{spacing.inset.lg}",
          "$type": "spacing",
          "$description": "Default inset for the scrollable dialog content area.",
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-spacing-content)"
            }
          }
        },
        "footer": {
          "$value": "{spacing.inset.lg}",
          "$type": "spacing",
          "$description": "Default inset for the dialog action area.",
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-spacing-footer)"
            }
          }
        },
        "sectionGap": {
          "$value": "{spacing.stack.md}",
          "$type": "spacing",
          "$description": "Gap between dialog header, content and footer regions when they do not have separate boundaries.",
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-spacing-sectionGap)"
            }
          }
        },
        "actionGap": {
          "$value": "{spacing.inline.md}",
          "$type": "spacing",
          "$description": "Gap between dialog actions.",
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--component-dialog-spacing-actionGap)"
            }
          }
        }
      }
    }
  }
}
