{
    "typography": {
      "family": {
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, Consolas, monospace",
          "$type": "fontFamily",
          "$description": "System monospace stack for selectable code. No font download; the platform selects the available face. Figma uses Roboto Mono Regular as an illustrative metric reference, not a claim of identical glyph widths.",
          "$extensions": {
            "com.figma.scopes": [
              "FONT_FAMILY"
            ],
            "com.figma.codeSyntax": {
              "Web": "var(--typography-family-mono)"
            }
          }
        },
        "sans": {
          "$value": "Inter",
          "$type": "fontFamily"
        }
      },
  
      "weight": {
        "regular": {
          "$value": "400",
          "$type": "fontWeight"
        },
  
        "medium": {
          "$value": "500",
          "$type": "fontWeight"
        },
  
        "semibold": {
          "$value": "600",
          "$type": "fontWeight"
        },
  
        "bold": {
          "$value": "700",
          "$type": "fontWeight"
        }
      },
  
      "size": {
        "xs": {
          "$value": "0.75rem",
          "$type": "fontSize"
        },
  
        "sm": {
          "$value": "0.875rem",
          "$type": "fontSize"
        },
  
        "md": {
          "$value": "1rem",
          "$type": "fontSize"
        },
  
        "lg": {
          "$value": "1.125rem",
          "$type": "fontSize"
        },
  
        "xl": {
          "$value": "1.25rem",
          "$type": "fontSize"
        },
  
        "2xl": {
          "$value": "1.5rem",
          "$type": "fontSize"
        },
  
        "3xl": {
          "$value": "1.875rem",
          "$type": "fontSize"
        },
  
        "4xl": {
          "$value": "2.25rem",
          "$type": "fontSize"
        },
  
        "5xl": {
          "$value": "3rem",
          "$type": "fontSize"
        },
  
        "6xl": {
          "$value": "3.75rem",
          "$type": "fontSize"
        }
      },
  
      "lineHeight": {
        "tight": {
          "$value": "120%",
          "$type": "lineHeight"
        },
  
        "normal": {
          "$value": "150%",
          "$type": "lineHeight"
        },
  
        "relaxed": {
          "$value": "170%",
          "$type": "lineHeight"
        }
      },
  
      "letterSpacing": {
        "tight": {
          "$value": "-0.02em",
          "$type": "letterSpacing"
        },
  
        "normal": {
          "$value": "0",
          "$type": "letterSpacing"
        },
  
        "wide": {
          "$value": "0.02em",
          "$type": "letterSpacing"
        }
      }
    }
  }