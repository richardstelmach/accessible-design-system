      "md": {
        "$value": "{spacing.4}",
        "$type": "spacing",
        "$description": "Default horizontal gap between related inline items such as buttons, navigation items or grouped actions."
      },
      "lg": {
        "$value": "{spacing.6}",
        "$type": "spacing",
        "$description": "Large horizontal gap between inline groups where more separation is needed."
